{
  "toggle-layout#shelf-01": {
    "title": "Ativar/Desativar - Vitrine 01",
    "props": {
      "renderChildren": true
    },
    "children": [
      "flex-layout.row#shelf-01"
    ]
  },
  "flex-layout.row#shelf-01": {
    "title": "Vitrine 01",
    "props": {
      "blockClass": [
        "container__shelf-row",
        "grid1252",
        "grid-mobile"
      ],
      "fullWidth": true,
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.col#shelf-01"
    ]
  },
  "flex-layout.col#shelf-01": {
    "props": {
      "blockClass": "container__shelf-col",
      "fullWidth": true
    },
    "children": [
      "flex-layout.row#shelf-01-title",
      "flex-layout.row#shelf-demo-01"
    ]
  },
  "flex-layout.row#shelf-01-title": {
    "props": {
      "blockClass": "container__shelf-row-text",
      "fullWidth": true,
      "preventHorizontalStretch": true
    },
    "children": [
      "rich-text#shelf-title-01",
      "rich-text#shelf-link-01"
    ]
  },
  "rich-text#shelf-title-01": {
    "title": "Título",
    "props": {
      "text": "## Mais vendidos",
      "blockClass": "shelfTitle"
    }
  },
  "rich-text#shelf-link-01": {
    "title": "Link",
    "props": {
      "text": "[Ver mais](/verao)",
      "blockClass": "shelfLink"
    }
  },
  "flex-layout.row#shelf-demo-01": {
    "children": [
      "list-context.product-list#demo1"
    ]
  },
  "list-context.product-list#demo1": {
    "blocks": [
      "product-summary.shelf#main"
    ],
    "children": [
      "slider-layout#demo-products"
    ],
    "props": {
      "orderBy": "",
      "installmentCriteria": "MAX_WITHOUT_INTEREST",
      "hideUnavailableItems": true,
      "collection": "",
      "maxItems": 12
    }
  },
  "slider-layout#demo-products": {
    "props": {
      "itemsPerPage": {
        "desktop": 5,
        "tablet": 3,
        "phone": 2
      },
      "showNavigationArrows": "desktopOnly",
      "infinite": true,
      "fullWidth": true,
      "blockClass": [
        "container__shelf-slider",
        "carousel",
        "grid1252"
      ]
    }
  }
}