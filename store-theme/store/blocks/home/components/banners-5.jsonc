{
  "toggle-layout#banners-5": {
    "title": "Ativar/Desativar - Banner Triplo 3",
    "props": {
      "renderChildren": true
    },
    "children": [
      "responsive-layout.desktop#banners-5",
      "responsive-layout.mobile#banners-5"
    ]
  },
  "responsive-layout.desktop#banners-5": {
    "children": ["flex-layout.row#banners-5"]
  },
  "flex-layout.row#banners-5": {
    "title": "Banner Triplo 3 - Desktop",
    "props": {
      "blockClass": ["banners", "banners-2"],
      "colSizing": "auto",
      "fullWidth": "true"
    },
    "children": [
      "image-new-custom#banner-10",
      "image-new-custom#banner-11",
      "image-new-custom#banner-12"
    ]
  },
