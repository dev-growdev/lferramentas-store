{
  "toggle-layout#slider-categories-home": {
    "title": "Ativar/Desativar Slider home",
    "props": {
      "renderChildren": true,
      "blockClass": "toggle-slider-categories-home"
    },
    "children": [
      "flex-layout.row#slider-categories-home"
    ]
  },
  "flex-layout.row#slider-categories-home": {
    "children": [
      "slider-layout#slider-categories-home"
    ],
    "props": {
      "fullWidth": true,
      "blockClass": [
        "slider-categories-home"
      ]
    }
  },
  "slider-layout#slider-categories-home": {
    "children": [
      "flex-layout.col#categories-item-01",
      "flex-layout.col#categories-item-02",
      "flex-layout.col#categories-item-03",
      "flex-layout.col#categories-item-04",
      "flex-layout.col#categories-item-05",
      "flex-layout.col#categories-item-06",
      "flex-layout.col#categories-item-07",
      "flex-layout.col#categories-item-08"
    ],
    "props": {
      "blockClass": "slider-categories-home",
      "infinite": true,
      "itemsPerPage": {
        "desktop": 8,
        "tablet": 4,
        "mobile": 2
      },
      "centerMode": {
        "phone": "to-the-left",
        "desktop": "disabled"
      },
      "centerModeSlidesGap": 16,
      "showNavigationArrows": "never",
      "showPaginationDots": "mobileOnly",
      "fullWidth": true
    }
  },
  "flex-layout.col#categories-item-01": {
    "title": "Item 01",
    "children": [
      "image-new-custom#categories-item-01",
      "rich-text#title-categories-item-01"
    ],
    "props": {
      "blockClass": [
        "category-item"
      ]
    }
  },
  "image-new-custom#categories-item-01": {
    "title": "Imagem Categorias Home 01",
    "props": {
      "src": "/assets/vtex.file-manager-graphql/images/baedf5a7-40d5-43c9-9e98-fc8eb05da92b___d9706eba98eb84fc72ac58b770807af4.png",
      "height": "133px",
      "width": "133px",
      "link": {
        "attributeNofollow": false,
        "url": "/"
      },
      "alt": "Imagem categorias home 1",
      "blockClass": [
        "category-item"
      ]
    }
  },
  "rich-text#title-categories-item-01": {
    "title": "Texto Categorias Home 01",
    "props": {
      "blockClass": [
        "title-categories-item"
      ],
      "text": "Quimicos"
    }
  },
