{
  "toggle-layout#banners-2": {
    "title": "Ativar/Desativar - Banner Triplo 1",
    "props": {
      "renderChildren": true
    },
    "children": [
      "responsive-layout.desktop#banners-2",
      "responsive-layout.mobile#banners-2"
    ]
  },
  "responsive-layout.desktop#banners-2": {
    "children": ["flex-layout.row#banners-2"]
  },
  "flex-layout.row#banners-2": {
    "title": "Banner Triplo 1 - Desktop",
    "props": {
      "blockClass": ["banners", "banners-2"],
      "colSizing": "auto",
      "fullWidth": "true"
    },
    "children": [
      "image-new-custom#banner-2",
      "image-new-custom#banner-3",
      "image-new-custom#banner-4"
    ]
  },
  "image-new-custom#banner-2": {
    "title": "Banner Home 2",
    "props": {
      "blockClass": ["banners"],
      "experimentalPreventLayoutShift": true,
      "experimentalSetExplicitDimensions": true,
      "width": "343px",
      "height": "270px",
      "src": "/assets/vtex.file-manager-graphql/images/39b8a38c-50ea-40e7-90a9-4177eea8487a___d77c0441c49a34006b9248375719824e.png",
      "alt": "Soldador",
      "link": {
        "url": "/"
      }
    }
  },
