{
  "toggle-layout#banners-6": {
    "title": "Ativar/Desativar - Banner Duplo 2",
    "props": {
      "renderChildren": true
    },
    "children": [
      "responsive-layout.desktop#banners-6",
      "responsive-layout.mobile#banners-6"
    ]
  },
  "responsive-layout.desktop#banners-6": {
    "children": ["flex-layout.row#banners-6"]
  },
  "flex-layout.row#banners-6": {
    "title": "Banner Duplo 2 - Desktop",
    "props": {
      "blockClass": ["banners", "banners-3"],
      "colSizing": "auto",
      "fullWidth": "true"
    },
    "children": ["image-new-custom#banner-13", "image-new-custom#banner-14"]
  },
