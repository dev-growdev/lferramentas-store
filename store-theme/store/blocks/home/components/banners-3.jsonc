    "title": "Banner Duplo 1 - Mobile",
    "props": {
      "blockClass": ["banners", "banners-3"],
      "colSizing": "auto",
      "fullWidth": "true"
    },
    "children": [
      "image-new-custom#banner-5-mobile",
      "image-new-custom#banner-6-mobile"
    ]
  },
