{
  "toggle-layout#banners-3": {
    "title": "Ativar/Desativar - Banner Duplo 1",
    "props": {
      "renderChildren": true
    },
    "children": [
      "responsive-layout.desktop#banners-3",
      "responsive-layout.mobile#banners-3"
    ]
  },
  "responsive-layout.desktop#banners-3": {
    "children": ["flex-layout.row#banners-3"]
  },
  "flex-layout.row#banners-3": {
    "title": "Banner Duplo 1 - Desktop",
    "props": {
      "blockClass": ["banners", "banners-3"],
      "colSizing": "auto",
      "fullWidth": "true"
    },
    "children": ["image-new-custom#banner-5", "image-new-custom#banner-6"]
  },
  "image-new-custom#banner-5": {
    "title": "Banner Home 5",
    "props": {
      "blockClass": ["banners"],
      "experimentalPreventLayoutShift": true,
      "experimentalSetExplicitDimensions": true,
      "width": "343px",
      "height": "112px",
      "src": "/assets/vtex.file-manager-graphql/images/98717da3-3363-4c46-b7c4-81a0c19a6eca___1488ee124a449caace4c2ce0251f6b7c.png",
      "alt": "Pedreiro",
      "link": {
        "url": "/"
      }
    }
  },
  "image-new-custom#banner-6": {
