{
  "toggle-layout#slider-brand-home": {
    "title": "Ativar/Desativar Marcas Slider Home",
    "props": {
      "renderChildren": true
    },
    "children": [
      "flex-layout.row#row-slider-brand-home"
    ]
  },
  "flex-layout.row#row-slider-brand-home": {
    "title": "Marcas em Slider",
    "children": [
      "flex-layout.row#brand-slider-title",
      "list-context.image-list-custom#brands-slider"
    ],
    "props": {
      "fullWidth": true,
      "blockClass": [
        "row-slider-brand-home"
      ]
    }
  },
  "list-context.image-list-custom#brands-slider": {
    "title": "Lista de banners de marcas",
