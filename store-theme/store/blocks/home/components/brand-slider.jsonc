  "flex-layout.row#brand-slider-title": {
    "props": {
      "blockClass": "container__shelf-row-text",
      "fullWidth": true,
      "preventHorizontalStretch": true
    },
    "children": [
      "rich-text#title-brand-home",
      "rich-text#brand-home-link"
    ]
  },
  "rich-text#title-brand-home": {
    "title": "Título",
    "props": {
      "blockClass": [
        "title-brand-home",
        "shelfTitle"
      ],
      "text": "## Compre por marca"
    }
  },
  "rich-text#brand-home-link": {
    "title": "Link",
    "props": {
      "text": "[Ver mais](/)",
      "blockClass": "shelfLink"
    }
  },
  "slider-layout#slider-brand-home": {
    "props": {
      "blockClass": [
        "container__shelf-slider",
        "slider-brand-home"
      ],
      "infinite": true,
      "itemsPerPage": {
        "desktop": 6,
        "tablet": 4,
        "mobile": 2
      },
      "centerMode": {
        "phone": "to-the-left",
        "desktop": "disabled"
      },
      "centerModeSlidesGap": 16,
      "showNavigationArrows": "desktopOnly",
      "showPaginationDots": "mobileOnly"
    }
  }
}