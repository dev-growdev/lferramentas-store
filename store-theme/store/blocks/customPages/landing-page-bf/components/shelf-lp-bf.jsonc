{
  "toggle-layout#shelf-lp-bf": {
    "title": "Ativar/Desativar - Vitrine 01",
    "props": {
      "renderChildren": true
    },
    "children": [
      "flex-layout.row#shelf-lp-bf"
    ]
  },
  "flex-layout.row#shelf-lp-bf": {
    "title": "Vitrine 01",
    "props": {
      "blockClass": [
        "container__shelf-row",
        "grid1252",
        "grid-mobile"
      ],
      "fullWidth": true,
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.col#shelf-lp-bf"
    ]
  },
  "flex-layout.col#shelf-lp-bf": {
    "props": {
      "blockClass": "container__shelf-col",
      "fullWidth": true
    },
    "children": [
      "flex-layout.row#shelf-lp-bf-title",
      "flex-layout.row#shelf-demo-lp-bf"
    ]
  },
  "flex-layout.row#shelf-lp-bf-title": {
    "props": {
      "blockClass": "container__shelf-row-text",
      "fullWidth": true,
      "preventHorizontalStretch": true
    },
    "children": [
      "rich-text#shelf-title-lp-bf"
    ]
  },
  "rich-text#shelf-title-lp-bf": {
    "title": "Título",
    "props": {
      "text": "## Mais vendidos na Black Friday de 2023 na LF!",
      "blockClass": ["shelfTitle", "title-shelf-lp-bf"]
    }
  },
  "flex-layout.row#shelf-demo-lp-bf": {
    "children": [
      "list-context.product-list#demo1"
    ]
  }
}