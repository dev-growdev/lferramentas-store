{
  "toggle-layout#lp-bf-deals": {
    "title": "Ativar/Desativar - Mosaico de Ofertas",
    "props": {
      "renderChildren": true
    },
    "children": [
      "rich-text#lp-bf-benefits",
      "flex-layout.row#lp-bf-deals",
      "rich-text#text-lp-bf-benefits"
    ]
  },
  "flex-layout.row#lp-bf-deals": {
    "title": "Mosaico de Ofertas",
    "props": {
      "blockClass": "lp-bf-deals",
      "fullWidth": true
    },
    "children": ["slider-layout#lp-bf-deals"]
  },
  "slider-layout#lp-bf-deals": {
    "children": [
      "flex-layout.row#lp-bf-deals01",
      "flex-layout.row#lp-bf-deals02",
      "flex-layout.row#lp-bf-deals03",
      "flex-layout.row#lp-bf-deals04",
      "flex-layout.row#lp-bf-deals05"
    ],
    "props": {
      "blockClass": "lp-bf-deals",
      "infinite": false,
      "itemsPerPage": {
        "desktop": 5,
        "tablet": 5,
        "mobile": 1
      },
      "centerMode": {
        "phone": "to-the-left",
        "desktop": "disabled"
      },
      "centerModeSlidesGap": 16,
      "showNavigationArrows": "never",
      "showPaginationDots": "mobileOnly"
    }
  },
