{
  "flex-layout.col#scroll-layout-lp-bf": {
    "title": "Coluna principal do scroll horizontal Black Friday",
    "props": {
      "blockClass": "scroll-layout-lp-bf",
      "width": "100%"
    },
    "children": ["rich-text#scroll-lp-bf-title", "custom-horizontal-scroll"]
  },
  "rich-text#scroll-lp-bf-title": {
    "title": "Título principal do carrossel destaques Black Friday",
    "props": {
      "blockClass": "scroll-lp-bf-title",
      "text": "ITENS QUE FORAM SUCESSO NA BLACK FRIDAY LF DE 2024:",
      "textAlignment": "CENTER",
      "textPosition": "CENTER"
    }
  },
  "custom-horizontal-scroll": {
    "title": "Carrossel horizontal de destaques Black Friday",
    "children": [
      "flex-layout.col#lp-bf-scrollcontent-1-left",
      "flex-layout.col#lp-bf-scrollcontent-1-right",
      "flex-layout.col#lp-bf-scrollcontent-4-left",
      "flex-layout.col#lp-bf-scrollcontent-4-right",
      "flex-layout.col#lp-bf-scrollcontent-2-left",
      "flex-layout.col#lp-bf-scrollcontent-2-right",
      "flex-layout.col#lp-bf-scrollcontent-5-left",
      "flex-layout.col#lp-bf-scrollcontent-5-right",
      "flex-layout.col#lp-bf-scrollcontent-3-left",
      "flex-layout.col#lp-bf-scrollcontent-3-right",
      "flex-layout.col#lp-bf-scrollcontent-6-left",
      "flex-layout.col#lp-bf-scrollcontent-6-right"
    ]
  },
  "flex-layout.col#lp-bf-scrollcontent-4-left": {
    "title": "Coluna esquerda 4 do carrossel Black Friday",
    "children": [
      "image-new-custom#lp-bf-scrollcontent-4-left-top",
      "image-new-custom#lp-bf-scrollcontent-4-left-down"
    ]
  },
  "image-new-custom#lp-bf-scrollcontent-4-left-top": {
    "title": "Imagem superior da coluna esquerda 4",
    "props": {
      "blockClass": "lp-bf-scrollcontent-left",
      "height": "auto",
      "src": "https://placehold.co/300x200",
      "alt": "Imagem da esquerda 1"
    }
  },
  "image-new-custom#lp-bf-scrollcontent-4-left-down": {
    "title": "Imagem inferior da coluna esquerda 4",
    "props": {
      "blockClass": "lp-bf-scrollcontent-left",
      "height": "auto",
      "src": "https://placehold.co/300x200",
      "alt": "Imagem da esquerda 2"
    }
  },
  "flex-layout.col#lp-bf-scrollcontent-4-right": {
    "title": "Coluna direita 4 do carrossel Black Friday",
    "children": ["image-new-custom#lp-bf-scrollcontent-4-right"]
  },
  "image-new-custom#lp-bf-scrollcontent-4-right": {
    "title": "Imagem da coluna direita 4",
    "props": {
      "blockClass": "lp-bf-scrollcontent-right",
      "experimentalPreventLayoutShift": true,
