  "flex-layout.row#lp-bf-promotion-cards": {
    "children": [
      "flex-layout.col#lp-bf-promotion-cards-left",
      "flex-layout.col#lp-bf-promotion-cards-right"
    ],
    "props": {
      "blockClass": "lp-bf-promotion-cards",
      "colSizing": "equal"
    }
  },
  "flex-layout.col#lp-bf-promotion-cards-left": {
    "children": ["flex-layout.row#lp-bf-promotion-cards-left"]
  },
  "flex-layout.row#lp-bf-promotion-cards-left": {
    "children": [
      "flex-layout.col#lp-bf-promotion-cards-left-1",
      "flex-layout.col#lp-bf-promotion-cards-right-1"
    ],
    "props": {
      "blockClass": "lp-bf-promotion-card",
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true,
      "horizontalAlign": "center"
    }
  },
  "flex-layout.col#lp-bf-promotion-cards-left-1": {
    "children": ["image-new-custom#lp-bf-promotion-cards-left"]
  },
  "image-new-custom#lp-bf-promotion-cards-left": {
    "title": "Imagem da esquerda",
    "props": {
      "blockClass": "lp-bf-promotion-cards-left",
      "width": "224px",
      "height": "auto",
      "src": "https://lfmaquinaseferramentas.vtexassets.com/assets/vtex.file-manager-graphql/images/e22b3eb2-e3f1-4458-a333-e26a731af20a___54429b9211f611b54784e64a5e3c4a5c.png",
      "alt": "Pague com Pix"
    }
  },
  "flex-layout.col#lp-bf-promotion-cards-right-1": {
    "children": [
      "rich-text#lp-bf-promotion-cards-right-title",
      "rich-text#lp-bf-promotion-cards-right-description"
    ],
    "props": {
      "preventVerticalStretch": true,
      "blockClass": "lp-bf-promotion-cards-text"
    }
  },
  "rich-text#lp-bf-promotion-cards-right-title": {
    "title": "Título da promoção",
    "props": {
      "text": "PAGUE COM PIX",
      "blockClass": "lp-bf-promotion-cards-right-title"
    }
  },
  "rich-text#lp-bf-promotion-cards-right-description": {
    "title": "Descrição da promoção",
    "props": {
      "text": "Garanta **5% de desconto** comprando no Pix! Sua compra é aprovada na hora e o despacho do seu pedido é imediato!",
      "blockClass": "lp-bf-promotion-cards-right-description"
    }
  },
  "flex-layout.col#lp-bf-promotion-cards-right": {
    "children": ["flex-layout.row#lp-bf-promotion-cards-right"]
  },
  "flex-layout.row#lp-bf-promotion-cards-right": {
    "children": [
      "flex-layout.col#lp-bf-promotion-cards-left-2",
      "flex-layout.col#lp-bf-promotion-cards-right-2"
    ],
    "props": {
      "blockClass": "lp-bf-promotion-card",
      "preventHorizontalStretch": true
    }
  },
  "flex-layout.col#lp-bf-promotion-cards-left-2": {
    "children": ["image-new-custom#lp-bf-promotion-cards-left-2"]
  },
  "image-new-custom#lp-bf-promotion-cards-left-2": {
    "title": "Imagem da esquerda",
    "props": {
      "blockClass": "lp-bf-promotion-cards-left",
      "experimentalPreventLayoutShift": true,
      "experimentalSetExplicitDimensions": true,
      "width": "100%",
      "height": "auto",
      "src": "https://lfmaquinaseferramentas.vtexassets.com/assets/vtex.file-manager-graphql/images/e22b3eb2-e3f1-4458-a333-e26a731af20a___54429b9211f611b54784e64a5e3c4a5c.png ",
      "alt": "Imagem da esquerda"
    }
  },
  "flex-layout.col#lp-bf-promotion-cards-right-2": {
    "children": [
      "rich-text#lp-bf-promotion-cards-right-title-2",
      "rich-text#lp-bf-promotion-cards-right-description-2"
    ],
    "props": {
      "preventVerticalStretch": true,
      "blockClass": "lp-bf-promotion-cards-text"
    }
  },
  "rich-text#lp-bf-promotion-cards-right-title-2": {
    "title": "Título da promoção",
    "props": {
      "text": "CUPONS DE DESCONTO.",
      "blockClass": "lp-bf-promotion-cards-right-title"
    }
  },
  "rich-text#lp-bf-promotion-cards-right-description-2": {
    "title": "Descrição da promoção",
    "props": {
      "text": "Você pode aproveitar *cupons especiais de primeira compra* e conferir diversos outros descontos que serão revelados durante a Black Friday da LF!",
      "blockClass": "lp-bf-promotion-cards-right-description"
    }
  }
}
