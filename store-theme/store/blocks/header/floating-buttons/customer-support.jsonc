{
  "drawer#header-floating-buttons-customer-support": {
    "blocks": [
      "drawer-header#header-floating-buttons-customer-support",
      "drawer-trigger#header-floating-buttons-customer-support"
    ],
    "children": [
      "flex-layout.row#customer-support"
    ],
    "props": {
      "blockClass": [
        "customer-support"
      ],
      "slideDirection": "rightToLeft",
      "isFullWidth": true
    }
  },
  "drawer-trigger#header-floating-buttons-customer-support": {
    "children": [
      "image-new-custom#header-floating-buttons-customer-support"
    ]
  },
  "image-new-custom#header-floating-buttons-customer-support": {
    "title": "Ícone Atendimento ao Cliente",
    "props": {
      "width": "40px",
      "height": "40px",
      "alt": "Atendimento ao Cliente",
      "blockClass": [
        "header-floating-buttons"
      ],
      "src": "assets/icons/icon-customer-support.svg" 
    }
  },
  "drawer-header#header-floating-buttons-customer-support": {
    "props": {
      "blockClass": [
        "customer-support"
      ]
    },
    "children": [
      "drawer-close-button",
      "rich-text#header-floating-buttons-customer-support-title"
    ]
  },
  "rich-text#header-floating-buttons-customer-support-title": {
    "title": "Atendimento ao Cliente - Texto",
    "props": {
      "blockClass": [
        "header-floating-buttons-customer-support-title"
      ],
      "text": "##### Olá, estamos aqui para ajudar"
    }
  },
  "flex-layout.row#customer-support": {
    "title": "Atendimento ao Cliente",
    "props": {
      "blockClass": [
        "customer-support"
      ],
      "preserveLayoutOnMobile": true,
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.col#customer-support"
    ]
  },
  "flex-layout.col#customer-support": {
    "props": {
      "blockClass": [
        "customer-support"
      ],
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.row#customer-support-item-01",
      "flex-layout.row#customer-support-item-02",
      "flex-layout.row#customer-support-item-03",
      "flex-layout.row#customer-support-item-04",
      "flex-layout.row#customer-support-item-05",
      "flex-layout.row#customer-support-item-06"
    ]
  },
  /* Item 01 */
  "flex-layout.row#customer-support-item-01": {
    "title": "Atendimento ao Cliente - Item 01",
    "props": {
      "blockClass": [
        "customer-support-item",
        "customer-support-item-01"
      ],
      "preserveLayoutOnMobile": true,
      "preventVerticalStretch": true,
      "preventHorizontalStretch": true
    },
    "children": [
      "link#customer-support-item-01"
    ]
  },
  "link#customer-support-item-01": {
    "title": "Atendimento ao Cliente - Item 01 Link",
    "props": {
      "blockClass": [
        "customer-support-item",
        "customer-support-item-01"
      ],
      "target": "_blank",
      "href": "http://ajuda.lfmaquinaseferramentas.com.br/"
    },
    "children": [
      "image-new-custom#customer-support-item-01",
      "rich-text#customer-support-item-01"
    ]
  },
  "image-new-custom#customer-support-item-01": {
    "title": "Atendimento ao Cliente - Item 01 Imagem",
    "props": {
      "blockClass": [
        "customer-support-item",
        "customer-support-item-01"
      ],
      "width": "28px",
      "height": "29px",
      "src": "assets/icons/customer-support-01.svg"
    }
  },
  "rich-text#customer-support-item-01": {
    "title": "Atendimento ao Cliente - Item 01 Texto",
    "props": {
      "blockClass": [
        "customer-support-item",
        "customer-support-item-01"
      ],
      "text": "###### Perguntas Frequentes \n\n Saiba tudo sobre formas de pagamento, \n entrega e outras dúvidas."
    }
  },
  /* Item 02 */
  "flex-layout.row#customer-support-item-02": {
    "title": "Atendimento ao Cliente - Item 02",
    "props": {
      "blockClass": [
        "customer-support-item",
        "customer-support-item-02"
      ],
      "preserveLayoutOnMobile": true,
      "preventVerticalStretch": true,
      "preventHorizontalStretch": true
    },
    "children": [
