    "props": {
      "blockClass": [
        "customer-support-item",
        "customer-support-item-02"
      ],
      "target": "_blank",
      "href": "https://api.whatsapp.com/send?1=pt_BR&phone=555131030100"
    },
    "children": [
      "image-new-custom#customer-support-item-02",
