{
  "name": "lfmaquinaseferramentas.store-theme",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "vlink": "vtex unlink && vtex link",
    "sass": "concurrently \"sass --watch --no-source-map styles/sass:styles/css\" \"sass --watch --no-source-map react/styles:react\"",
    "dev": "concurrently \"yarn vlink\" \"yarn sass\"",
    "build": "sass --no-source-map styles/sass:styles/css",
    "deploy": "yarn build && vtex publish && vtex install"
  },
  "devDependencies": {
    "@apollo/react-testing": "3",
    "@commitlint/cli": "^17.5.1",
    "@commitlint/config-conventional": "^17.4.4",
    "@vtex/prettier-config": "^1.0.0",
    "@vtex/test-tools": "^3.4.3",
    "concurrently": "^8.2.2",
    "eslint": "^8.37.0",
    "eslint-config-vtex": "^15.0.2",
    "eslint-config-vtex-react": "^9.0.3",
    "lint-staged": "^13.2.0",
    "prettier": "^2.8.7",
    "react-intl": "3",
    "stylelint": "^15.4.0",
    "stylelint-config-standard": "^32.0.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-order": "^6.0.3",
    "typescript": "3.9.7"
  },
  "dependencies": {
    "sass": "^1.76.0"
  }
}
